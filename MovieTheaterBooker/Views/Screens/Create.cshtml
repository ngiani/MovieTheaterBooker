@model MovieTheaterBooker.Models.ScreenCreateVM

@{
    ViewData["Title"] = "Add New Screen";
}

<div class="text-center mb-4">
    <h1><i class="fas fa-plus-circle"></i> Add New Screen</h1>
</div>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="details-container">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group">
                    <label asp-for="Name" class="form-label">
                        <i class="fas fa-tag"></i> Screen Name
                    </label>
                    <input asp-for="Name" class="form-control" placeholder="e.g., Screen 1, IMAX Hall" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="rowsCount" class="form-label">
                        <i class="fas fa-grip-lines"></i> Number of Rows
                    </label>
                    <input asp-for="rowsCount" class="form-control" type="number" placeholder="Enter number of rows" />
                    <span asp-validation-for="rowsCount" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="rowsLength" class="form-label">
                        <i class="fas fa-chair"></i> Seats per Row
                    </label>
                    <input asp-for="rowsLength" class="form-control" type="number" placeholder="Enter seats per row" />
                    <span asp-validation-for="rowsLength" class="text-danger"></span>
                </div>

                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> Total seats will be: <strong>Rows × Seats per Row</strong>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-success flex-fill">
                        <i class="fas fa-save"></i> Create Screen
                    </button>
                    <a asp-action="Index" class="btn btn-danger flex-fill">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}