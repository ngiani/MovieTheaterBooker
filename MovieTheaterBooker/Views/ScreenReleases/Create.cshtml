@model MovieTheaterBooker.Data.ScreenRelease

@{
    ViewData["Title"] = "Add Screen Release";
}

<div class="text-center mb-4">
    <h1><i class="fas fa-calendar-plus"></i> Add New Screen Release</h1>
    <p class="lead text-muted">for <span class="text-light">@Model.Movie.Title</span></p>
</div>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="details-container">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group">
                    <label asp-for="ScreenId" class="form-label">
                        <i class="fas fa-tv"></i> Select Screen
                    </label>
                    <select asp-for="ScreenId" class="form-control" asp-items="@(ViewData["ScreenId"] as SelectList)">
                        <option value="">-- Choose a screen --</option>
                    </select>
                    <span asp-validation-for="ScreenId" class="text-danger"></span>
                </div>

                <input type="hidden" asp-for="MovieId" />

                <div class="form-group">
                    <label asp-for="ReleaseTime" class="form-label">
                        <i class="far fa-calendar-alt"></i> Release Date & Time
                    </label>
                    <input asp-for="ReleaseTime" class="form-control" type="datetime-local"
                           value="@Model.ReleaseTime.ToString("yyyy-MM-ddTHH:mm")" />
                    <span asp-validation-for="ReleaseTime" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-success flex-fill">
                        <i class="fas fa-save"></i> Create Release
                    </button>
                    <a asp-action="Details" asp-controller="Movies" asp-route-id=@Model.MovieId class="btn btn-danger flex-fill">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
