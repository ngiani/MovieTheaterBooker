@model MovieTheaterBooker.Data.ScreenRelease

@{
    ViewData["Title"] = "Edit Screen Release";
}

<div class="text-center mb-4">
    <h1><i class="fas fa-edit"></i> Edit Screen Release</h1>
</div>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="details-container">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />

                <div class="form-group">
                    <label asp-for="ReleaseTime" class="form-label">
                        <i class="far fa-calendar-alt"></i> Release Date & Time
                    </label>
                    <input asp-for="ReleaseTime" class="form-control" type="datetime-local" />
                    <span asp-validation-for="ReleaseTime" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary flex-fill">
                        <i class="fas fa-save"></i> Save Changes
                    </button>
                    <a asp-action="Details" asp-route-id=@Model.MovieId asp-controller="Movies" class="btn btn-danger flex-fill">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
