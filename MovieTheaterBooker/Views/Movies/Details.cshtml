@model MovieTheaterBooker.Models.MovieDetailsVM

@{
    ViewData["Title"] = Model.Title;
}

<div class="details-container">
    <div class="row">
        <div class="col-md-4">
            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://via.placeholder.com/400x600/2f2f2f/ffffff?text=" + Uri.EscapeDataString(Model.Title) : Model.ImageUrl)" 
                 class="img-fluid w-100" 
                 alt="@Model.Title"
                 onerror="this.src='https://via.placeholder.com/400x600/2f2f2f/ffffff?text=No+Image'" />
        </div>
        <div class="col-md-8">
            <h1><i class="fas fa-film"></i> @Html.DisplayFor(model => model.Title)</h1>
            <hr />
            <dl class="row">
                <dt class="col-sm-3">
                    <i class="fas fa-align-left"></i> @Html.DisplayNameFor(model => model.Plot)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Plot)
                </dd>
                <dt class="col-sm-3">
                    <i class="fas fa-tag"></i> @Html.DisplayNameFor(model => model.Genre)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Genre)
                </dd>
                <dt class="col-sm-3">
                    <i class="far fa-clock"></i> @Html.DisplayNameFor(model => model.Duration)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Duration) minutes
                </dd>
            </dl>
        </div>
    </div>
</div>

@{
    //Check if there are screen releases for the movie
    if (Model.Releases.Count > 0)
    {
        var groupedReleases = Model.Releases.GroupBy(r => r.ReleaseTime.DayOfWeek);

        <h2><i class="far fa-calendar-alt"></i> Upcoming Showtimes</h2>

        //Show screen releases for each day
        foreach (var group in groupedReleases)
        {
            var day = group.Key.ToString();
            var orderedGroup = group.OrderBy(g => g.ReleaseTime);

            <div class="mb-4">
                <h4 class="text-light">
                    <i class="fas fa-calendar-day"></i> @day
                </h4>
                <h6 class="text-muted mb-3">
                    @group.ToList()[0].ReleaseTime.Date.ToString("dd/MM/yyyy")
                </h6>

                <div class="row">
                    @foreach (var item in orderedGroup)
                    {
                        var hour = item.ReleaseTime.ToString("HH:mm");
                        var screen = item.Screen.Name.ToString();

                        <div class="col-md-3 col-sm-6 mb-3">
                            <div class="card time-slot-card">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        <i class="far fa-clock"></i> @hour
                                    </h5>
                                    <p class="card-text">
                                        <i class="fas fa-tv"></i> @screen
                                    </p>
                                    @{
                                        //If admin, can delete or edit the screen release
                                        if (User.IsInRole(Roles.Administrator))
                                        {
                                            <div class="d-flex gap-2">
                                                <a asp-action="Delete" asp-controller="ScreenReleases" asp-route-id=@item.Id 
                                                   class="btn btn-danger btn-sm flex-fill">
                                                    <i class="fas fa-trash"></i> Delete
                                                </a>
                                                <a asp-action="Edit" asp-controller="ScreenReleases" asp-route-id=@item.Id 
                                                   class="btn btn-primary btn-sm flex-fill">
                                                    <i class="fas fa-edit"></i> Edit
                                                </a>
                                            </div>
                                        }
                                        //Otherwise, user can book
                                        else
                                        {
                                            <a class="btn btn-primary w-100" asp-controller="Screens" asp-action="DetailsAtRelease"
                                               asp-route-id=@item.Screen.Id asp-route-releaseId=@item.Id>
                                                <i class="fas fa-ticket-alt"></i> Book Now
                                            </a>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info text-center">
            <i class="fas fa-info-circle"></i> No showtimes available for this movie yet.
        </div>
    }

    <hr />

    //If user is an admin, can delete the movie or add a new screen release
    if (User.IsInRole(Roles.Administrator))
    {
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-success" asp-controller="ScreenReleases" asp-route-movieId=@Model.Id asp-action="Create">
                <i class="fas fa-plus-circle"></i> Add New Release
            </a>
            <a asp-action="Index" class="btn btn-danger">
                <i class="fas fa-arrow-left"></i> Back to List
            </a>
        </div>
    }
    else
    {
        <a class="btn btn-primary" asp-controller="Movies" asp-action="Index">
            <i class="fas fa-arrow-left"></i> Back to Movies
        </a>
    }
}
