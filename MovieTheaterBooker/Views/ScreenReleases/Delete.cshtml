@model MovieTheaterBooker.Data.ScreenRelease

@{
    ViewData["Title"] = "Delete Screen Release";
}

<div class="text-center mb-4">
    <h1 class="text-danger"><i class="fas fa-exclamation-triangle"></i> Delete Screen Release</h1>
    <p class="lead text-muted">Are you sure you want to delete this showtime?</p>
</div>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="details-container">
            <div class="text-center mb-4">
                <i class="fas fa-calendar-times fa-4x text-danger mb-3"></i>
            </div>

            <dl class="row">
                <dt class="col-sm-4">
                    <i class="far fa-calendar-alt"></i> Release Time
                </dt>
                <dd class="col-sm-8">
                    @Html.DisplayFor(model => model.ReleaseTime)
                </dd>
            </dl>

            <div class="alert alert-danger mt-3">
                <i class="fas fa-info-circle"></i> This action cannot be undone. All bookings for this showtime will be affected.
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-danger flex-fill">
                        <i class="fas fa-trash"></i> Confirm Delete
                    </button>
                    <a asp-action="Details" asp-route-id=@Model.MovieId asp-controller="Movies" class="btn btn-primary flex-fill">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
