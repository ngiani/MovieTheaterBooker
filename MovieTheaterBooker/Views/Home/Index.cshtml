@{
    ViewData["Title"] = "Home";
}

<div class="text-center">
    <div class="mb-5">
        <i class="fas fa-film fa-5x mb-3" style="color: var(--primary-color);"></i>
        <h1 class="display-3 mb-3">Welcome to MovieTheaterBooker</h1>
        <p class="lead text-muted mb-4">Your premier destination for booking movie tickets online</p>
    </div>

    <div class="row justify-content-center mb-5">
        <div class="col-md-10">
            <div class="details-container">
                <div class="row text-center">
                    <div class="col-md-4 mb-4">
                        <i class="fas fa-search fa-3x mb-3" style="color: var(--primary-color);"></i>
                        <h4>Browse Movies</h4>
                        <p class="text-muted">Explore the latest releases and upcoming films</p>
                    </div>
                    <div class="col-md-4 mb-4">
                        <i class="fas fa-calendar-check fa-3x mb-3" style="color: var(--primary-color);"></i>
                        <h4>Select Showtime</h4>
                        <p class="text-muted">Choose from multiple showtimes that fit your schedule</p>
                    </div>
                    <div class="col-md-4 mb-4">
                        <i class="fas fa-ticket-alt fa-3x mb-3" style="color: var(--primary-color);"></i>
                        <h4>Book Tickets</h4>
                        <p class="text-muted">Secure your seats with our easy booking system</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-5">
        <a asp-controller="Movies" asp-action="Index" class="btn btn-primary btn-lg">
            <i class="fas fa-play-circle"></i> Browse Movies Now
        </a>
    </div>
</div>
