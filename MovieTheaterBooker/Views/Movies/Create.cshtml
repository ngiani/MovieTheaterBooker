@model MovieTheaterBooker.Data.Movie

@{
    ViewData["Title"] = "Add New Movie";
}

<div class="text-center mb-4">
    <h1><i class="fas fa-plus-circle"></i> Add New Movie</h1>
</div>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="details-container">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group">
                    <label asp-for="Title" class="form-label">
                        <i class="fas fa-heading"></i> @Html.DisplayNameFor(model => model.Title)
                    </label>
                    <input asp-for="Title" class="form-control" placeholder="Enter movie title" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Plot" class="form-label">
                        <i class="fas fa-align-left"></i> @Html.DisplayNameFor(model => model.Plot)
                    </label>
                    <textarea asp-for="Plot" class="form-control" rows="4" placeholder="Enter movie plot"></textarea>
                    <span asp-validation-for="Plot" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Genre" class="form-label">
                        <i class="fas fa-tag"></i> @Html.DisplayNameFor(model => model.Genre)
                    </label>
                    <input asp-for="Genre" class="form-control" placeholder="e.g., Action, Drama, Comedy" />
                    <span asp-validation-for="Genre" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Duration" class="form-label">
                        <i class="far fa-clock"></i> @Html.DisplayNameFor(model => model.Duration)
                    </label>
                    <input asp-for="Duration" class="form-control" type="number" placeholder="Duration in minutes" />
                    <span asp-validation-for="Duration" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ImageUrl" class="form-label">
                        <i class="fas fa-image"></i> Image URL
                    </label>
                    <input asp-for="ImageUrl" class="form-control" placeholder="https://example.com/poster.jpg" />
                    <span asp-validation-for="ImageUrl" class="text-danger"></span>
                    <small class="text-muted">Enter a valid image URL (e.g., from TMDB, IMDb, or upload to a hosting service)</small>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-success flex-fill">
                        <i class="fas fa-save"></i> Create Movie
                    </button>
                    <a asp-action="Index" class="btn btn-danger flex-fill">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
