@model Screen

@{
    ViewData["Title"] = "Delete Screen";
}

<div class="text-center mb-4">
    <h1 class="text-danger"><i class="fas fa-exclamation-triangle"></i> Delete Movie</h1>
    <p class="lead text-muted">Are you sure you want to delete this movie?</p>
</div>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="details-container">
            <div class="text-center mb-4">
                <i class="fas fa-film fa-4x text-danger mb-3"></i>
                <h3 class="text-light">@Html.DisplayFor(model => model.Name)</h3>
            </div>

            <div class="alert alert-danger mt-3">
                <i class="fas fa-info-circle"></i> This action cannot be undone. All associated screen releases will also be affected.
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-danger flex-fill">
                        <i class="fas fa-trash"></i> Confirm Delete
                    </button>
                    <a asp-action="Index" class="btn btn-primary flex-fill">
                        <i class="fas fa-times"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>